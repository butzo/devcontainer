#!/usr/bin/env bash
# obsidian-bridge: host end of the devc Obsidian bridge.
#
# Lets the agent in a vault's container rename and move notes through the
# Obsidian CLI on the host, so Obsidian updates the links. The CLI itself
# (the Electron binary, talking to the running app) never enters the
# container: gen-config binds a per-vault socket dir at /run/obsidian-bridge,
# and bridge/obsidian-client inside sends one request per connection.
#
#   obsidian-bridge ensure <vault>   start the listener if it is not answering
#   obsidian-bridge stop   <vault>   stop it and remove the socket
#   obsidian-bridge serve  [<vault>] handle one request on stdin (socat runs
#                                    this per connection; vault also via
#                                    $OBSIDIAN_BRIDGE_VAULT)
#
# Runtime dir: $XDG_RUNTIME_DIR/obsidian-bridge/<id>/ with <id> the same
# sha256 prefix devc.just uses for ~/.cache/devc/<id>. run/sock is what the
# container sees; pid and log stay outside the mount.
#
# Request: command line, then key=value lines, ended by a blank line or EOF.
# Response: the CLI's output, then one line `__status=0|1` (the CLI exits 0
# even on errors, so its `Error:` lines decide).
set -euo pipefail
umask 077

self=$(readlink -f "$0")
die() { printf 'obsidian-bridge: %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[33mWARN\033[0m obsidian-bridge: %s\n' "$*" >&2; }

cmd=${1:-}
vault=${2:-${OBSIDIAN_BRIDGE_VAULT:-}}
case "$cmd" in ensure | stop | serve) ;; *) die "usage: obsidian-bridge ensure|stop|serve <vault>" ;; esac
[ -n "$vault" ] || die "usage: obsidian-bridge $cmd <vault>"
vault=$(cd "$vault" && pwd -P) || die "no such vault: $vault"
rt=${XDG_RUNTIME_DIR:-}
[ -n "$rt" ] || die "XDG_RUNTIME_DIR unset"
id=$(printf %s "$vault" | sha256sum | cut -c1-16)
dir="$rt/obsidian-bridge/$id"
sock="$dir/run/sock"
pidfile="$dir/pid"
log="$dir/log"
install -d -m 700 "$rt/obsidian-bridge" "$dir" "$dir/run"

# The allowlist. Commands map to the request keys they take, all required;
# `path=` only (exact, vault-relative), never `file=` (wikilink-style lookup,
# ambiguous between folders). Path values may not start under the paths that
# are masked or read-only in the container: the bridge acts on the host,
# where the git-crypt plaintext and the host-executed files live.
keys_for() {
  case "$1" in
    rename) echo "path name" ;;
    move) echo "path to" ;;
    *) return 1 ;;
  esac
}
DENIED_TOP='.obsidian .claudian confidential .git .claude .devcontainer .trash'
DENIED_EXACT='justfile'
MAX_REQUEST=4096
MAX_VALUE=1024
MAX_LOG=1048576
CLI_TIMEOUT=30

# --- serve -------------------------------------------------------------------
# Runs with the connection on stdin/stdout. Every exit path prints the status
# trailer; the process exit code is irrelevant to socat.
respond() { [ -z "$1" ] || printf '%s\n' "$1"; printf '__status=%s\n' "$2"; }
# The log sits in the runtime tmpfs the whole session shares, and the
# container chooses what gets refused: cap it (one rotation) and never log
# raw bytes.
logline() {
  if [ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt "$MAX_LOG" ]; then mv -f "$log" "$log.1"; fi
  printf '%s %s\n' "$(date -Is)" "$*" >> "$log"
}
refuse() {
  logline "refused $(printf %q "${1:0:200}"): $2"
  respond "Error: refused: $2" 1
  exit 0
}
check_value() { # <key> <value>
  [ -n "$2" ] || refuse "$1" "empty value for $1"
  [ "${#2}" -le "$MAX_VALUE" ] || refuse "$1" "value for $1 too large"
  case "$2" in
    *[[:cntrl:]]*) refuse "$1" "control character in $1" ;;
    *\\*) refuse "$1" "backslash in $1" ;;
  esac
}
# <key> <value> <-e|-m>: vault-relative and canonical (no `.`, `..`, empty
# components or trailing slash), outside the denied tops, and resolving to the
# same place on the host. The container can plant symlinks in the workspace,
# and its masks do not exist on the host, so a lexical check alone would let
# `notes/c -> confidential` reach the plaintext. -e: must exist (the source);
# -m: may not exist yet (the destination), existing prefix still resolved.
# The check runs just before the CLI; the window between is the container's
# to race, which the README notes.
check_path() {
  local key=$1 v=$2 mode=$3 top real
  case "$v" in /*) refuse "$key" "absolute path in $key: $v" ;; esac
  case "/$v/" in */../*) refuse "$key" "'..' in $key: $v" ;; esac
  case "/$v/" in */./* | *//*) refuse "$key" "$key is not canonical (./, // or trailing /): $v" ;; esac
  top=${v%%/*}
  for d in $DENIED_TOP; do
    [ "$top" != "$d" ] || refuse "$key" "$key under $d/ is not allowed: $v"
  done
  for f in $DENIED_EXACT; do
    [ "$v" != "$f" ] || refuse "$key" "$key $f is not allowed"
  done
  real=$(realpath "$mode" -- "$vault/$v" 2>/dev/null) || refuse "$key" "$key not found: $v"
  [ "$real" = "$vault/$v" ] || refuse "$key" "$key resolves elsewhere (symlink?): $v -> $real"
}
check_name() { # <key> <value>: a plain file name, no directory part, not hidden
  case "$2" in
    */*) refuse "$1" "'/' in $1 (use move to change folders): $2" ;;
    . | ..) refuse "$1" "$1 may not be $2" ;;
    .*) refuse "$1" "$1 may not start with '.' (hidden file): $2" ;;
  esac
}

serve() {
  local line req='' total=0 k v want
  declare -A kv=()
  while IFS= read -r -t 10 -n "$((MAX_REQUEST + 1))" line; do
    [ -n "$line" ] || break
    total=$((total + ${#line} + 1))
    [ "$total" -le "$MAX_REQUEST" ] || refuse "${req:-?}" "request too large"
    if [ -z "$req" ]; then
      req=$line
      [[ $req =~ ^[a-z]+$ ]] || refuse "$req" "malformed command"
      continue
    fi
    case "$line" in *=*) ;; *) refuse "$req" "malformed line (expected key=value)" ;; esac
    k=${line%%=*} v=${line#*=}
    [[ $k =~ ^[a-z]+$ ]] || refuse "$req" "malformed key: $k"
    [ -z "${kv[$k]+x}" ] || refuse "$req" "duplicate key: $k"
    kv[$k]=$v
  done
  [ -n "$req" ] || refuse "?" "empty request"
  if [ "$req" = ping ]; then respond pong 0; exit 0; fi
  want=$(keys_for "$req") || refuse "$req" "command not allowed: $req"
  for k in "${!kv[@]}"; do
    case " $want " in *" $k "*) ;; *) refuse "$req" "key not allowed for $req: $k" ;; esac
  done
  local args=("$req")
  for k in $want; do
    [ -n "${kv[$k]+x}" ] || refuse "$req" "missing $k= for $req"
    v=${kv[$k]}
    check_value "$k" "$v"
    case "$k" in path) check_path "$k" "$v" -e ;; to) check_path "$k" "$v" -m ;; name) check_name "$k" "$v" ;; esac
    args+=("$k=$v")
  done

  # vault= first: the CLI's own way to pin a vault (by folder name). The CLI
  # exits 0 on errors, so `Error:` on stdout decides. dbus noise from Electron
  # is dropped; everything else goes back verbatim. One CLI call at a time:
  # each is an Electron process, and the container controls how many arrive.
  local out rc=0 status=0
  exec 8>> "$dir/cli.lock"
  flock 8
  out=$(timeout "$CLI_TIMEOUT" obsidian "vault=$(basename "$vault")" "${args[@]}" 2>&1 < /dev/null 8>&-) || rc=$?
  flock -u 8
  out=$(grep -v 'ERROR:dbus' <<< "$out" || true)
  if [ "$rc" -eq 124 ]; then out="Error: obsidian did not answer within ${CLI_TIMEOUT}s (is the vault open?)"; fi
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ]; then out="$out"$'\n'"Error: obsidian exited $rc"; fi
  grep -q '^Error:' <<< "$out" && status=1
  logline "$(printf '%q ' "${args[@]}")-> $status"
  respond "$out" "$status"
}

# --- ensure / stop ----------------------------------------------------------
# run/ is the container's to write: `sock` may have been replaced by a
# symlink to some other host socket, or by a directory. Only a real socket
# owned by us is pinged; anything else is removed before (re)starting.
ping_sock() {
  [ ! -L "$sock" ] && [ -S "$sock" ] && [ -O "$sock" ] || return 1
  [ "$(printf 'ping\n\n' | timeout 5 socat -t 3 - "UNIX-CONNECT:$sock" 2>/dev/null | head -n1)" = pong ]
}
listener_pid() {
  local pid
  pid=$(cat "$pidfile" 2>/dev/null) || return 1
  [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = socat ] || return 1
  echo "$pid"
}
stop_listener() {
  local pid
  if pid=$(listener_pid); then kill "$pid" 2>/dev/null || true; fi
  rm -rf -- "$pidfile" "$sock"
}

ensure() {
  command -v socat > /dev/null || die "socat is not installed on the host"
  command -v obsidian > /dev/null || die "obsidian is not on PATH (Obsidian 1.12+, Settings → General → Command line interface)"
  if ! grep -qE '"alwaysUpdateLinks": *true' "$vault/.obsidian/app.json" 2>/dev/null; then
    warn "alwaysUpdateLinks is off in $vault/.obsidian/app.json: renames will not update links" \
      "(Obsidian: Settings → Files and links → Automatically update internal links)"
  fi
  if ping_sock; then return 0; fi
  stop_listener
  # socat splits EXEC on spaces, so the vault goes through the environment.
  # The listener outlives this shell (setsid) and dies with the session. It
  # must not inherit our stdio: a caller capturing our output (the Claudian
  # wrapper's spawnSync) would wait for the listener's EOF. -t keeps each
  # connection open after the client's EOF for as long as the CLI may take
  # (socat's default is 0.5 s); max-children bounds what the container can
  # fan out.
  # fd 9 is the ensure/stop lock: the listener must not inherit it, or the
  # lock stays taken for as long as it runs and the next ensure/stop hangs.
  # shellcheck disable=SC2016  # $$ and $1.. are the inner sh's
  OBSIDIAN_BRIDGE_VAULT=$vault setsid -f sh -c \
    'echo $$ > "$1"; exec socat -t "$4" "UNIX-LISTEN:$2,fork,max-children=8,unlink-early,umask=177" "EXEC:$3 serve"' \
    sh "$pidfile" "$sock" "$self" "$((CLI_TIMEOUT + 10))" < /dev/null > /dev/null 2>> "$dir/listener.log" 9>&-
  local _
  for _ in $(seq 1 30); do
    # socat's umask option leaves the socket at 700 on some versions.
    if ping_sock; then chmod 600 "$sock"; return 0; fi
    sleep 0.1
  done
  die "listener did not answer at $sock (see $dir/listener.log)"
}

# ensure and stop may run concurrently (devc up and a Claudian launch): one
# at a time, or two listeners race for the socket path.
case "$cmd" in
  serve) serve ;;
  ensure) exec 9>> "$dir/lock"; flock 9; ensure ;;
  stop) exec 9>> "$dir/lock"; flock 9; stop_listener ;;
esac
