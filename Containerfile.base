# arch-dev:base — everything the editor/shell environment needs.
# Toolchains live in derived images (see Containerfile.aio).
FROM docker.io/archlinux:base-devel

# Bust layer cache on scheduled rebuilds (see justfile / CI)
ARG CACHE_BUST=unset
RUN echo "cache-bust: ${CACHE_BUST}" && \
    pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
      # core
      git zsh neovim sudo openssh \
      ripgrep fd fzf lazygit yazi just \
      # CLI quality of life
      bat glow eza tree zoxide tealdeer \
      ncdu nload btop htop progress iperf3 hyperfine \
      jq yq rsync less wget tmux \
      zip unzip 7zip zstd xz \
      man-db man-pages texinfo \
      # sandbox layer for Claude Code (socat: its network proxy)
      bubblewrap socat \
      # terminals I actually use (terminfo only; alacritty's is in ncurses)
      kitty-terminfo \
      # LSPs / formatters / linters (mirrors host nvim config)
      clang ruff lua-language-server \
      tinymist marksman yaml-language-server taplo-cli bash-language-server \
      vscode-json-languageserver shellcheck shfmt stylua typstyle prettier \
      systemd-lsp \
      # nvim-treesitter (main branch) compiles parsers with it
      tree-sitter-cli \
      # rustup ships only shims here — no toolchain, so base stays toolchain-free.
      # aio installs the toolchain + the rust-analyzer component. The repo
      # rust-analyzer is not usable: it depends on rust-src -> rust, which drags
      # the whole toolchain into base and conflicts with rustup in aio.
      rustup \
      wl-clipboard \
    && pacman -Scc --noconfirm

# Locales: en_US + de_DE
RUN sed -i -e 's/^#en_US.UTF-8/en_US.UTF-8/' -e 's/^#de_DE.UTF-8/de_DE.UTF-8/' \
      /etc/locale.gen && locale-gen && \
    echo 'LANG=en_US.UTF-8' > /etc/locale.conf

# Non-root user matching host UID 1000 (pairs with --userns=keep-id)
ARG USERNAME=dev
ARG UID=1000
RUN useradd -m -u ${UID} -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Pre-create XDG dirs as dev. Otherwise podman creates them as root when it
# makes mountpoints for nested mounts (~/.config/nvim, ~/.local/share/nvim),
# and tools can't write there (e.g. zinit -> ~/.local/share/zinit).
RUN mkdir -p ~/.config ~/.cache ~/.local/share/nvim ~/.local/state

# paru (AUR helper) — built from source as the unprivileged user.
#
# Not paru-bin: its prebuilt binary links libalpm.so.15 while pacman now ships
# libalpm.so.16, and its `libalpm.so>=14` dep does not catch that, so it
# installs cleanly and then dies at runtime. Source paru is rebuilt against the
# current soname (hence its -2 pkgrel).
#
# Building it needs cargo, which base deliberately lacks. Pull a minimal
# toolchain in and drop it again inside this one RUN, so it never reaches the
# final layer and base stays toolchain-free.
RUN rustup toolchain install stable --profile minimal && \
    rustup default stable && \
    git clone --depth 1 https://aur.archlinux.org/paru.git /tmp/paru && \
    cd /tmp/paru && makepkg -si --noconfirm && \
    cd / && rm -rf /tmp/paru && \
    rustup toolchain uninstall stable && \
    rm -rf "$HOME/.cargo/registry" "$HOME/.cargo/git" && \
    paru --version

# AUR-only LSPs (not in the official repos, so pacman above can't see them)
RUN paru -S --noconfirm --needed basedpyright-bin jdtls && \
    paru -Scc --noconfirm

ENV EDITOR=nvim
CMD ["/bin/zsh"]
