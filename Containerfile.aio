# arch-dev:aio — base + all project toolchains.
# Split into per-language images later if/when this gets annoying.
ARG BASE=ghcr.io/butzo/arch-dev:base
FROM ${BASE}

USER root
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
      # Python
      python python-pip uv \
      # Java
      jdk-openjdk maven gradle \
      # Julia
      julia \
      # Rust: rustup itself comes from base; the toolchain is installed below.
      # Typst (tinymist LSP already in base)
      typst \
      # C/C++ native (gcc/make already in base-devel; add the extras)
      cmake ninja gdb \
      # serial terminal
      picocom \
    && pacman -Scc --noconfirm

USER dev

# AUR packages (not in the official repos, so pacman above can't see them)
RUN paru -S --noconfirm --needed claude-code && \
    paru -Scc --noconfirm

# claude wrapper (ahead of /usr/bin in PATH): reads the long-lived token from
# the mounted host file. Containers never share the host's rotating
# .credentials.json, whose refresh token dies once any copy refreshes.
USER root
RUN printf '%s\n' \
      '#!/bin/sh' \
      'f=/run/secrets/claude-oauth-token' \
      'if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -r "$f" ]; then' \
      '  CLAUDE_CODE_OAUTH_TOKEN=$(cat "$f"); export CLAUDE_CODE_OAUTH_TOKEN' \
      'fi' \
      'exec /usr/bin/claude "$@"' \
      > /usr/local/bin/claude && chmod 755 /usr/local/bin/claude
USER dev

# Rust stable toolchain baked into the image (weekly rebuild tracks stable);
# nightly/targets can still be added ad hoc inside containers via rustup.
RUN rustup default stable && \
    rustup component add clippy rustfmt rust-analyzer

# Julia LSP into the image's global depot
RUN julia -e 'using Pkg; Pkg.add("LanguageServer")' || \
    echo "WARN: Julia LanguageServer install failed (non-fatal)"
