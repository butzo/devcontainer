# Devcontainer driving.
#   .devcontainer/devcontainer.json    committed: image, masks, read-only overlays, mount slots
#   ~/.config/devcontainer/mounts.env  dotfiles: personal mounts (DEVC_MOUNT_n=...)
# The CLI's --mount flag rejects readonly/tmpfs, so every mount lives in
# devcontainer.json; this file only loads mounts.env into the env before `up`.

engine := "podman"
mounts_env := "~/.config/devcontainer/mounts.env"
# Claude Code config the container may see: an allowlisted copy of ~/.claude,
# mounted at /claude-seed by mounts.env. The rest of ~/.claude (projects/,
# file-history/, backups/, ...) holds every other project's transcripts.
seed_dir := "~/.cache/devcontainer/claude-seed"
seed_allow := ".git .gitignore CLAUDE.md settings.json AGENTS.md plugin.json marketplace.json agents commands ecc hooks plugins rules scripts skills"
load :="if [ -f " + mounts_env + " ]; then set -a; . " + mounts_env + "; set +a; else printf '\\033[33mNOTE\\033[0m no " + mounts_env + ", starting without personal mounts\\n' >&2; fi;"

# fails (non-zero) if devcontainer.json lacks a mask or overlay this repo needs,
# or enables an overlay whose host source is missing (podman would refuse)
_guard:
    #!/usr/bin/env bash
    set -euo pipefail
    live=$(grep -v '^[[:space:]]*//' .devcontainer/devcontainer.json)
    w='${localWorkspaceFolder}'
    mask()    { printf '"type=tmpfs,target=%s/%s,notmpcopyup"' "$w" "$1"; }
    overlay() { printf '"type=bind,source=%s/%s,target=%s/%s,readonly"' "$w" "$1" "$w" "$1"; }
    has()  { grep -qF "$1" <<<"$live"; }
    need() { has "$1" || { echo "ERROR: $2; enable in devcontainer.json: $1" >&2; exit 1; }; }
    for p in .git/hooks .git/config .devcontainer justfile; do
      need "$(overlay "$p")" "host-executed $p must be read-only"
    done
    if [ -e .git/git-crypt/keys ]; then
      for p in confidential .git/git-crypt; do need "$(mask "$p")" "git-crypt unlocked"; done
    fi
    if [ -d .obsidian ]; then
      need "$(overlay .obsidian)" ".obsidian/ exists (Obsidian vault)"
      need "$(mask .claudian)" ".obsidian/ exists (Obsidian vault)"
    fi
    for p in .git/hooks .git/config .devcontainer justfile .claude .obsidian; do
      if has "$(overlay "$p")" && [ ! -e "$p" ]; then
        echo "ERROR: overlay for $p enabled but $p is missing on the host" >&2; exit 1
      fi
    done
    if [ -f {{ mounts_env }} ]; then
      if (set -a; . {{ mounts_env }}; env) | grep -E '^DEVC_MOUNT_[0-9]+=' | grep -qE "source=($HOME|~)/\.claude/?(,|$)"; then
        echo "ERROR: {{ mounts_env }} mounts all of ~/.claude; point /claude-seed at {{ seed_dir }}" >&2; exit 1
      fi
      # `|| true`: no token slot means grep matches nothing, which pipefail
      # would otherwise turn into a silent `set -e` exit right here.
      tok=$(set -a; . {{ mounts_env }}; env | grep -E '^DEVC_MOUNT_[0-9]+=.*target=/run/secrets/claude-oauth-token' \
        | sed -nE 's/.*source=([^,]+).*/\1/p' | head -n1) || true
      if [ -n "$tok" ] && [ ! -f "$tok" ]; then
        echo "ERROR: $tok missing; run \`claude setup-token\` and save the token there (chmod 600)" >&2; exit 1
      fi
    fi

# stage the allowlisted Claude Code config for /claude-seed (host side)
_seed:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -d ~/.claude ] || exit 0
    mkdir -p {{ seed_dir }}
    filters=()
    for p in {{ seed_allow }}; do filters+=(--include="/$p"); done
    rsync -a --delete --delete-excluded "${filters[@]}" --exclude='/*' ~/.claude/ {{ seed_dir }}/
    chmod 700 {{ seed_dir }}  # rsync -a copies ~/.claude's mode onto it

# start-if-needed + check isolation + enter: the daily one
dev: up verify-isolation enter

# create or start the container (CLI output is shown only on failure)
up: _guard _seed
    @{{ load }} out=$(devcontainer up --docker-path {{ engine }} --workspace-folder . 2>&1) \
      || { printf '%s\n' "$out" >&2; exit 1; }

# open zsh in the running container
enter:
    @devcontainer exec --docker-path {{ engine }} --workspace-folder . zsh

# stop the container (its state is kept)
stop:
    {{ engine }} ps --filter "label=devcontainer.local_folder={{ justfile_directory() }}" -q \
      | xargs -r {{ engine }} stop

# recreate container (picks up newly pulled image / changed devcontainer.json / mounts.env)
rebuild: _guard _seed
    {{ load }} devcontainer up --docker-path {{ engine }} --workspace-folder . --remove-existing-container

# pull latest weekly image, then recreate
update: && rebuild
    {{ engine }} pull ghcr.io/butzo/arch-dev:aio

# escape hatch if the devcontainer CLI misbehaves
raw-enter:
    {{ engine }} exec -it $({{ engine }} ps --filter "label=devcontainer.local_folder={{ justfile_directory() }}" -q | head -1) zsh

# each mask must be an empty tmpfs and each overlay its own read-only mount
# (errors count as FAIL, not OK). .claude read-write is only a WARN: its
# overlay may be commented out on purpose.
verify-isolation:
    @devcontainer exec --docker-path {{ engine }} --workspace-folder . bash -c '\
      ok()   { printf "\033[32mOK  \033[0m %s\n" "$*"; }; \
      warn() { printf "\033[33mWARN\033[0m %s\n" "$*"; }; \
      fail() { printf "\033[31mFAIL\033[0m %s\n" "$*"; rc=1; }; \
      mask() { fs=$(stat -f -c %T "$1" 2>&1); \
        if [ "$fs" != tmpfs ]; then fail "$1/ not a tmpfs mask ($fs)"; \
        elif ! entries=$(ls -A "$1" 2>&1); then fail "$1/ unreadable: $entries"; \
        elif [ -n "$entries" ]; then fail "$1/ has content (tmpcopyup?)"; \
        else ok "$1/ empty tmpfs"; fi; }; \
      ro() { opts=$(findmnt -rno OPTIONS -M "$PWD/$1" 2>/dev/null); \
        if [ -z "$opts" ]; then $2 "$1 has no read-only overlay"; \
        else case ",$opts," in *,ro,*) ok "$1 read-only";; *) $2 "$1 mounted read-write";; esac; fi; }; \
      rc=0; \
      for p in confidential .git/git-crypt; do mask "$p"; done; \
      for p in .git/hooks .git/config .devcontainer justfile; do ro "$p" fail; done; \
      if [ -e .claude ]; then ro .claude warn; fi; \
      if [ -e .obsidian ]; then ro .obsidian fail; mask .claudian; fi; \
      for d in projects file-history session-data backups; do \
        if [ -e "/claude-seed/$d" ]; then fail "/claude-seed/$d visible (seed not staged)"; fi; \
      done; \
      f=$(git ls-tree -r --name-only HEAD -- confidential 2>/dev/null | head -1); \
      if [ -z "$f" ]; then warn "no committed confidential files to check"; \
      elif git cat-file blob "HEAD:$f" 2>/dev/null | head -c 10 | grep -qa GITCRYPT; then ok "committed blobs are ciphertext"; \
      else warn "could not confirm ciphertext ($f)"; fi; \
      exit $rc'
