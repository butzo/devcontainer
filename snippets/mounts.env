# Personal devcontainer mounts -> ~/.config/devcontainer/mounts.env
# (keep it in your dotfiles).
#
# The project justfile sources this with sh before `devcontainer up`, so
# ${HOME} expands to the host home dir; no username needs to be hardcoded.
# Each value fills
# the "${localEnv:DEVC_MOUNT_n:...}" slot in devcontainer.json and goes verbatim
# to `podman run --mount`, so readonly works. Slots 1-10 exist; unset ones
# become an empty tmpfs. No spaces in values. VS Code only sees these if they
# are exported in the environment it was launched from.
#
# Symlinks: a symlinked mount SOURCE is fine (resolved on the host), but
# symlinks INSIDE a mounted dir dangle in the container. Stow config dirs as
# folder links (not per-file) so a single dir mount works.
DEVC_MOUNT_1=type=bind,source=${HOME}/.config/nvim,target=/home/dev/.config/nvim,readonly
DEVC_MOUNT_2=type=volume,source=nvim-data,target=/home/dev/.local/share/nvim,readonly
# zsh: ~/.zshrc sets ZDOTDIR=~/.config/zsh itself; zinit clones on first start
DEVC_MOUNT_3=type=bind,source=${HOME}/.config/zsh,target=/home/dev/.config/zsh,readonly
DEVC_MOUNT_4=type=bind,source=${HOME}/.zshrc,target=/home/dev/.zshrc,readonly
DEVC_MOUNT_5=type=bind,source=${HOME}/.p10k.zsh,target=/home/dev/.p10k.zsh,readonly
DEVC_MOUNT_6=type=bind,source=${HOME}/.config/yazi,target=/home/dev/.config/yazi,readonly
DEVC_MOUNT_7=type=bind,source=${HOME}/.config/lazygit,target=/home/dev/.config/lazygit,readonly
DEVC_MOUNT_8=type=bind,source=${HOME}/.config/git,target=/home/dev/.config/git,readonly
# Claude Code config: the allowlisted copy `just up` stages from ~/.claude,
# never ~/.claude itself (projects/, file-history/, backups/ hold every other
# project's transcripts; `just up` refuses such a mount).
DEVC_MOUNT_9=type=bind,source=${HOME}/.cache/devcontainer/claude-seed,target=/claude-seed,readonly
# Auth: a long-lived token from `claude setup-token`, stored in a chmod 600
# file. The image's claude wrapper exports it as CLAUDE_CODE_OAUTH_TOKEN.
# Never share ~/.claude/.credentials.json: its refresh token rotates, so
# host and containers keep logging each other out. `just up` refuses to start
# if this file is missing.
DEVC_MOUNT_10=type=bind,source=${HOME}/.config/devcontainer/claude-oauth-token,target=/run/secrets/claude-oauth-token,readonly
